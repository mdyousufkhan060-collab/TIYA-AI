{
  "rewrites": [
    {
      "source": "/demos",
      "destination": "/demos/index.html"
    },
    {
      "source": "/demos/",
      "destination": "/demos/index.html"
    },
    {
      "source": "/shop/:slug",
      "destination": "/demos/store.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "has": [
        {
          "type": "host",
          "value": "www.myrosebd.com"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>[a-z0-9-]+)\\.myrosebd\\.com"
        }
      ],
      "destination": "/demos/store.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}