{
  "rewrites": [
    {
      "source": "/demos",
      "destination": "/demos/index.html"
    },
    {
      "source": "/demos/",
      "destination": "/demos/index.html"
    },
    {
      "source": "/shop/:slug",
      "destination": "/demos/store.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}