{
  "rewrites": [
    {
      "source": "/store-sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/demos",
      "destination": "/demos/index.html"
    },
    {
      "source": "/demos/",
      "destination": "/demos/index.html"
    },
    {
      "source": "/shop/:slug",
      "destination": "/api/shop?slug=:slug"
    },
    {
      "source": "/((?!.*\\.).*)",
      "has": [
        {
          "type": "host",
          "value": "www.myrosebd.com"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>[a-z0-9-]+)\\.myrosebd\\.com"
        }
      ],
      "destination": "/api/shop"
    },
    {
      "source": "/((?!.*\\.).*)",
      "missing": [
        {
          "type": "host",
          "value": "(.*\\.)?myrosebd\\.com"
        },
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        },
        {
          "type": "host",
          "value": "localhost"
        }
      ],
      "destination": "/api/shop"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
